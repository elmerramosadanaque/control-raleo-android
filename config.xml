<?xml version='1.0' encoding='utf-8'?>
<widget id="com.agriproserla.controlraleo" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Control Raleo</name>
  <description>Aplicación móvil para Control Raleo.</description>
  <author email="soporte@agriproserla.com" href="https://sistema-control-raleo.agriproserla.com">AgriProserla</author>
  <content src="index.html" />
  <access origin="*" />
  <allow-navigation href="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <preference name="AndroidXEnabled" value="true" />
  <preference name="ScrollEnabled" value="true" />
  <preference name="BackupWebStorage" value="local" />
  <preference name="DisallowOverscroll" value="true" />
  <platform name="android">
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="AndroidInsecureFileModeEnabled" value="false" />
  </platform>
</widget>
